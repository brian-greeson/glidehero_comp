{
  "name": "glidehero",
  "version": "0.1.0",
  "description": "GlideHero web application",
  "main": "dist/src/index.js",
  "engines": {
    "node": "25.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:push": "drizzle-kit push",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "start": "node dist/src/index.js",
    "worker": "node dist/src/worker.js",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:reset": "dropdb --if-exists \"$DB_NAME\" && createdb \"$DB_NAME\"",
    "import:launches": "tsx --env-file=.env src/scripts/importLaunches.ts",
    "import:state-arenas": "tsx --env-file=.env src/scripts/importStateArenas.ts"
  },
  "author": "Mountain Sentry",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1089.0",
    "@photostructure/tz-lookup": "^11.6.0",
    "@valkey/valkey-glide": "^2.4.2",
    "drizzle-orm": "^1.0.0-rc.4-5d5b77c",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "ventojs": "^2.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^1.0.0-rc.4-ca0f029",
    "pbf": "^5.1.2",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
