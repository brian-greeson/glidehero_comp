{{ layout "layouts/appLayout.vto" }}
<section class="dashboard competition-coverage has-competition-breadcrumb" data-competition-coverage="arena">
  {{ include "components/dashboardNav.vto" { activeMode: "competitive", currentPath: arena.path, currentUser, isAdmin, territoryColorSuccess, territoryColorError } }}
  {{ include "components/competitionBreadcrumb.vto" { arena } }}
  <section class="map-stage" aria-label="{{ arena.name }} Arena competition coverage map">
    <div class="map-canvas" data-territory-map data-map-style-url="{{ mapTilerStyleUrl }}"
      data-current-user-id="{{ currentUser.userId }}" data-territory-color="{{ currentUser.territoryColor }}"
      data-territory-tile-minimum-zoom="{{ territoryTileConfig.competition.minimumZoom }}"
      data-territory-tile-maximum-zoom="{{ territoryTileConfig.competition.maximumZoom }}"
      data-arena-source-id="{{ arena.sourceId }}"></div>
    {{ include "components/arenaSearch.vto" }}
    <p class="map-empty-state" data-map-empty-state hidden></p>
    {{ include "components/mapFlightAidStatus.vto" }}
    <div class="coverage-cell-popup" data-territory-cell-popup hidden></div>
  </section>
  <aside class="dashboard-info" data-mobile-sheet aria-label="{{ arena.name }} coverage rankings">
    <button type="button" class="sheet-handle" data-sheet-toggle aria-expanded="false"
      aria-controls="coverage-information"><span aria-hidden="true"></span><span class="sr-only"
        data-sheet-toggle-label>Expand coverage rankings</span></button>
    <div id="coverage-information" class="dashboard-information">{{ include "components/coverageLeaderboardCard.vto" }}
    </div>
  </aside>
  {{ include "components/onboarding.vto" { territoryColor: currentUser.territoryColor } }}
</section>
{{ /layout }}
