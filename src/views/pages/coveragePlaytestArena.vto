{{ layout "layouts/appLayout.vto" }}
  <section class="dashboard coverage-playtest has-competition-breadcrumb" data-coverage-playtest="arena">
    {{ include "components/coveragePlaytestNav.vto" }}
    <nav class="competition-breadcrumb" aria-label="Coverage location"><a href="/playtest/coverage/global" data-competition-period-link="/playtest/coverage/global">Global coverage</a><span aria-hidden="true">››</span><span aria-current="page">{{ arena.name }}</span></nav>
    <section class="map-stage" aria-label="{{ arena.name }} coverage playtest map">
      <div class="map-canvas" data-coverage-map data-map-style-url="{{ mapTilerStyleUrl }}" data-current-user-id="{{ currentUser.userId }}" data-territory-color="{{ currentUser.territoryColor }}" data-arena-source-id="{{ arena.sourceId }}"></div>
      {{ include "components/arenaSearch.vto" }}
      <p class="map-empty-state" data-map-empty-state hidden></p>
      <div class="coverage-cell-popup" data-coverage-cell-popup hidden></div>
    </section>
    <aside class="dashboard-info" data-mobile-sheet aria-label="Arena coverage rankings">
      <button type="button" class="sheet-handle" data-sheet-toggle aria-expanded="false" aria-controls="coverage-information"><span aria-hidden="true"></span><span class="sr-only" data-sheet-toggle-label>Expand coverage rankings</span></button>
      <div id="coverage-information" class="dashboard-information">{{ include "components/coveragePlaytestLeaderboard.vto" }}</div>
    </aside>
  </section>
{{ /layout }}
