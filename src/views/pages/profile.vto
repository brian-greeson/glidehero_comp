{{ layout "layouts/appLayout.vto" }}
  <section class="admin-page profile-page">
    <header class="profile-nav">
      <a class="brand" href="/personal" aria-label="Glide Hero dashboard">
        <img class="brand-logo" src="/android-chrome-192x192.png" alt=""><span class="brand-name">GLIDE HERO</span>
      </a>
      <a class="profile-nav-link" href="/personal">Personal Map</a>
    </header>
    <main class="profile-content">
      <a class="profile-back-link" href="/personal">← Back to Personal Map</a>
      {{ include "components/pilotProfileSummary.vto" { profile, profileIsCurrent } }}
      {{ include "components/profileArenaLeadershipList.vto" { profile, profileIsCurrent } }}
      {{ include "components/profileAchievementProgress.vto" { profile, profileIsCurrent } }}
      {{ include "components/profileAchievementHelp.vto" }}
      {{ include "components/profileAchievementList.vto" { achievements: profile.achievements, achievementCount: profile.achievementCount, profileIsCurrent } }}
      {{ include "components/profileRecentFlights.vto" { flights: profile.recentFlights, profileIsCurrent } }}
    </main>
  </section>
{{ /layout }}
