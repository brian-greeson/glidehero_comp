{{ layout "layouts/appLayout.vto" }}
  <section class="not-found">
    <img class="not-found-illustration" src="/404-flying-squirrel.webp" alt="A flying squirrel paraglider pilot safely landed beside its wing in a remote mountain meadow">
    <div class="not-found-copy">
      <p class="not-found-eyebrow">A little off course</p>
      <h1>Looks like you landed out.</h1>
      <p>This corner of Glide Hero is more remote than expected. Pack up your wing and head back home.</p>
      <a class="primary-button" href="/">Head home</a>
    </div>
  </section>
{{ /layout }}
