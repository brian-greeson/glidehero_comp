{{ layout "layouts/appLayout.vto" }}
  <section class="admin-page activity-page">
    <header class="profile-nav">
      <a class="brand" href="/personal" aria-label="Glide Hero dashboard">
        <img class="brand-logo" src="/android-chrome-192x192.png" alt=""><span class="brand-name">GLIDE HERO</span>
      </a>
      <nav class="profile-nav-links" aria-label="Pilot navigation">
        <a class="profile-nav-link" href="/personal">Personal Map</a>
        <a class="profile-nav-link" href="/activity" aria-current="page">Activity</a>
      </nav>
    </header>
    <main class="activity-content">
      <h1>Activity</h1>
      <form method="get" action="/activity" class="activity-search-form">
        <label for="activity-pilot-search">Find pilots</label>
        <div><input id="activity-pilot-search" name="q" type="search" value="{{ activitySearch }}" maxlength="100"><button type="submit">Search</button></div>
      </form>
      {{ if activitySearch }}{{ include "components/pilotSearchResults.vto" { activityPilotResults, activityReturnTo } }}{{ /if }}
      <section class="activity-feed-shell" aria-labelledby="activity-feed-heading">
        <h2 id="activity-feed-heading">Your activity feed</h2>
        {{ include "components/activityFeedList.vto" { activityFeed, activityNextCursor, activityLoadMoreHref, activityLoadMoreEndpoint } }}
      </section>
    </main>
  </section>
{{ /layout }}
