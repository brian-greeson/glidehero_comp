{{ layout "layouts/appLayout.vto" }}
<section class="dashboard competition-coverage has-dashboard-breadcrumb" data-dashboard data-dashboard-mode="global"
  data-competition-coverage="global">
  {{ include "components/dashboardNav.vto" { activeMode: "competitive", currentPath: "/global", currentUser, isAdmin, territoryColorSuccess, territoryColorError } }}
  {{ include "components/dashboardBreadcrumb.vto" { activeMode: "competitive", arena: undefined, dashboardAchievementProgress } }}
  <section class="map-stage" aria-label="Global competition coverage map">
    <div class="map-canvas" data-territory-map data-map-style-url="{{ mapTilerStyleUrl }}"
      data-current-user-id="{{ currentUser.userId }}" data-territory-color="{{ currentUser.territoryColor }}"
      data-territory-tile-minimum-zoom="{{ if territoryTileConfig.competition.minimumZoom === 0 }}0{{ else }}{{ territoryTileConfig.competition.minimumZoom }}{{ /if }}"
      data-territory-tile-maximum-zoom="{{ if territoryTileConfig.competition.maximumZoom === 0 }}0{{ else }}{{ territoryTileConfig.competition.maximumZoom }}{{ /if }}"></div>
    {{ include "components/arenaSearch.vto" }}
    <p class="map-empty-state" data-map-empty-state hidden></p>
    {{ include "components/mapFlightAidStatus.vto" }}
    <div class="coverage-cell-popup" data-territory-cell-popup hidden></div>
  </section>
  <aside class="dashboard-info" data-mobile-sheet aria-label="Coverage rankings">
    <button type="button" class="sheet-handle" data-sheet-toggle aria-expanded="false"
      aria-controls="coverage-information"><span aria-hidden="true"></span><span class="sr-only"
        data-sheet-toggle-label>Expand coverage rankings</span></button>
    <div id="coverage-information" class="dashboard-information">{{ include "components/coverageLeaderboardCard.vto" }}
    </div>
  </aside>
  {{ include "components/onboarding.vto" { territoryColor: currentUser.territoryColor } }}
</section>
{{ /layout }}
