<div class="activity-feed-container" data-activity-feed-container>
  {{ if activityFeed.length === 0 }}
    <p class="activity-empty-feed" data-activity-empty>
      Nothing to show yet. <a href="/personal">Upload a flight</a> or <a href="/activity#activity-pilot-search">search for pilots</a> to see activity here.
    </p>
  {{ else }}
    <div class="activity-feed-list" data-activity-feed-list>
      {{ for activity of activityFeed }}
        {{ include "components/activityFeedItem.vto" { activity } }}
      {{ /for }}
    </div>
  {{ /if }}
  {{ if activityNextCursor }}
    <a class="activity-load-more" data-activity-load-more data-fragment-href="{{ activityLoadMoreEndpoint }}" href="{{ activityLoadMoreHref }}">Load more</a>
    <p class="activity-load-more-status" data-activity-load-more-status aria-live="polite"></p>
  {{ /if }}
</div>
