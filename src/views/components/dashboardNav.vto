<header class="dashboard-nav">
  <a class="brand" href="/personal" aria-label="Glide Hero dashboard"><img class="brand-logo" src="/android-chrome-192x192.png" alt=""><span class="brand-name">GLIDE HERO</span></a>
  <nav class="mode-tabs" aria-label="Map mode">
    <a href="/global" data-competition-period-link="/global" class="mode-tab{{ if activeMode === 'competitive' }} is-active{{ /if }}"{{ if activeMode === 'competitive' }} aria-current="page"{{ /if }}>Competitive</a>
    <a href="/personal" class="mode-tab{{ if activeMode === 'personal' }} is-active{{ /if }}"{{ if activeMode === 'personal' }} aria-current="page"{{ /if }}>Personal</a>
  </nav>
  <div class="nav-actions">
    <div class="upload-form">
      <button type="button" class="upload-button" data-upload-trigger aria-controls="flight-upload-dialog">Upload</button>
    </div>
    <div class="account-menu">
      <button type="button" class="account-trigger" data-account-trigger aria-expanded="false" aria-controls="account-popover">
        <span class="avatar" aria-hidden="true">{{ currentUser.displayName.slice(0, 1) }}</span>
        <span class="account-name">{{ currentUser.displayName }}</span>
      </button>
      <section id="account-popover" class="account-popover" data-account-popover hidden>
        <p class="account-email">{{ currentUser.email }}</p>
        <a class="profile-link" href="/profile">My Progress</a>
        {{ if isAdmin }}<a class="admin-link" href="/admin">Admin</a>{{ /if }}
        <button type="button" class="account-help-button" data-onboarding-trigger aria-controls="glide-hero-onboarding">Help &amp; walkthrough</button>
        <form method="post" action="/profile/territory-color">
          <input type="hidden" name="returnTo" value="{{ currentPath }}" data-competition-return-to>
          <label>Territory color<input name="territoryColor" type="color" value="{{ currentUser.territoryColor }}" required></label>
          {{ if territoryColorSuccess }}<p class="success" role="status">Map color saved.</p>{{ /if }}
          {{ if territoryColorError }}<p class="error" role="alert">{{ territoryColorError }}</p>{{ /if }}
          <button type="submit" class="secondary-button">Save map color</button>
        </form>
        <form method="post" action="/logout"><button type="submit" class="logout-button">Log out</button></form>
      </section>
    </div>
  </div>
</header>
<dialog id="flight-upload-dialog" class="flight-upload-dialog" data-upload-dialog aria-labelledby="flight-upload-title">
  <section class="flight-upload-panel">
    <header>
      <div><p class="admin-eyebrow">Flight upload</p><h2 id="flight-upload-title">Uploading flights</h2></div>
      <div class="flight-upload-header-actions"><strong data-upload-overall>0/0</strong><button type="button" class="flight-upload-close" data-upload-close aria-label="Close upload status">&times;</button></div>
    </header>
    <div class="flight-processing-progress">
      <div><strong>Processing flights</strong><span data-flight-progress-count>0/0</span></div>
      <progress max="1" value="0" data-flight-progress-bar></progress>
    </div>
    <div class="flight-upload-list" data-upload-list></div>
    <footer>
      <a class="secondary-button flight-upload-progress-link" data-upload-progress-link href="/profile" hidden>View my progress</a>
      <label class="secondary-button">Choose flights<input data-upload-more-input type="file" accept=".igc,.zip" multiple></label>
    </footer>
  </section>
</dialog>
