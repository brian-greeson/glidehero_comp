<section class="landing" data-auth-landing data-auth-initial="{{ if signupError }}signup{{ else }}login{{ /if }}"
  {{ if loginError }} data-auth-reveal{{ /if }}{{ if signupError }} data-auth-reveal{{ /if }}>
  <section class="landing-hero" aria-labelledby="landing-heading">
    <div class="landing-hero-brand" aria-hidden="true">
      <img src="/android-chrome-192x192.png" alt="">
      <span>GLIDE HERO</span>
    </div>
    <div class="landing-copy">
      <h1 id="landing-heading">Try the thermal-aware XC planner.</h1>
      <a class="landing-plan-cta" href="/plan">
        {{ include "authenticated/components/icon.vto" { name: "paper-plane", className: "landing-plan-cta__icon" } }}
        <span>Try XC Planner</span>
      </a>
    </div>
  </section>

  <section class="landing-auth" aria-label="Glide Hero account access">
    <div class="auth-panel">
      <header class="auth-brand">
        <img src="/android-chrome-192x192.png" alt="">
        <p>GLIDE HERO</p>
      </header>

      <section id="login-panel" class="auth-form-panel" data-auth-panel="login" aria-labelledby="login-heading"
        {{ if signupError }} hidden{{ /if }}>
        <div class="auth-heading">
          <h2 id="login-heading">Welcome back</h2>
          <p class="auth-switch-copy">New to Glide Hero? <button type="button" class="auth-text-button"
              data-auth-switch="signup">Create an account</button></p>
        </div>
        {{ if loginError }}
        <p class="error" role="alert">{{ loginError }}</p>{{ /if }}
        <form method="post" action="/login">
          <label>Email
            <input name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com"
              required value="{{ loginEmail ?? '' }}">
          </label>
          <label>Password
            <input name="password" type="password" autocomplete="current-password" minlength="3" maxlength="128"
              placeholder="Enter your password" required>
          </label>
          <button type="submit" class="auth-submit">Log in</button>
        </form>
      </section>

      <section id="signup-panel" class="auth-form-panel" data-auth-panel="signup" aria-labelledby="signup-heading"
        {{ if !signupError }} hidden{{ /if }}>
        <div class="auth-heading">
          <h2 id="signup-heading">Create your account</h2>
          <p>Start building your Personal Map.</p>
          <p class="auth-switch-copy">Already have an account? <button type="button" class="auth-text-button"
              data-auth-switch="login">Log in</button></p>

        </div>
        {{ if signupError }}
        <p class="error" role="alert">{{ signupError }}</p>{{ /if }}
        <form method="post" action="/signup">
          <label>Display name <span class="optional">Optional</span>
            <input name="displayName" maxlength="48" autocomplete="nickname" placeholder="Sky Pilot"
              value="{{ signupDisplayName ?? '' }}">
          </label>
          <label>Email
            <input name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com"
              required value="{{ signupEmail ?? '' }}">
          </label>
          <label>Password
            <input name="password" type="password" autocomplete="new-password" minlength="3" maxlength="128"
              placeholder="Create a password" required>
          </label>
          <button type="submit" class="auth-submit">Create account</button>
        </form>
      </section>
      {{ include "components/supportGlideHero.vto" }}
    </div>
  </section>
</section>
