<section class="info-card viewport-stats" data-competition-stats aria-busy="true" hidden>
  <h2>Stats</h2>
  <dl aria-live="polite">
    <div><dt>Claimed Area</dt><dd data-competition-claimed-area>-</dd></div>
    <div><dt>Flights</dt><dd data-competition-flights>-</dd></div>
    <div><dt>Pilots</dt><dd data-competition-pilots>-</dd></div>
    <div><dt>My Flights</dt><dd data-competition-my-flights>-</dd></div>
    <div><dt>% of Visible Map Claimed</dt><dd data-competition-claimed-percentage>-</dd></div>
  </dl>
</section>
