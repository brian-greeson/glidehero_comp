<section class="info-card arena-personal-progress" data-arena-personal-progress aria-label="Your Arena progress">
  <h2>Your progress</h2>
  {{ if arenaProgress.kind === "launch" }}
    <p><strong>Visited:</strong> {{ if arenaProgress.visited }}Yes{{ else }}No{{ /if }}</p>
    <p><strong>Cells claimed:</strong> {{ arenaProgress.claimedCells }}/{{ arenaProgress.totalCells }}</p>
    {{ if arenaProgress.complete }}<p class="arena-progress-complete">Complete</p>{{ /if }}
  {{ else if arenaProgress.kind === "general" }}
    <p><strong>Cells claimed:</strong> {{ arenaProgress.claimedCells }}/{{ arenaProgress.totalCells }}</p>
    <p><strong>Coverage:</strong> {{ arenaProgress.coveragePercentage }}%</p>
    {{ if arenaProgress.nextMilestone }}<p><strong>Next milestone:</strong> {{ arenaProgress.nextMilestone }}%</p>{{ else }}<p class="arena-progress-complete">All milestones reached</p>{{ /if }}
  {{ else }}
    <p><strong>Flown in:</strong> {{ if arenaProgress.flownIn }}Yes{{ else }}No{{ /if }}</p>
  {{ /if }}
</section>
