<section class="info-card leaderboard-card" data-competition-leaderboard aria-busy="true">
  <h2>Leaderboard</h2>
  <p class="leaderboard-period" data-competition-month>Loading current month…</p>
  <p class="leaderboard-status" data-leaderboard-status aria-live="polite">Loading rankings…</p>
  <div class="leaderboard-list" data-leaderboard-list role="list" aria-label="Competition leaders"></div>
  <div class="current-pilot-result" data-current-pilot-result hidden></div>
</section>
