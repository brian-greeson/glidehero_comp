<section class="info-card leaderboard-card" data-competition-leaderboard aria-busy="true">
  <h2>Leaderboard</h2>
  <div class="leaderboard-period" data-competition-period role="group" aria-label="Competition time period">
    <button type="button" data-competition-period-option="all-time" aria-pressed="true">All Time</button>
    <span aria-hidden="true">|</span>
    <button type="button" data-competition-period-option="current-month" aria-pressed="false"><span data-current-month-option>Current Month</span></button>
  </div>
  <p class="leaderboard-status" data-leaderboard-status aria-live="polite">Loading rankings…</p>
  <div class="leaderboard-list" data-leaderboard-list role="list" aria-label="Competition leaders"></div>
  <div class="current-pilot-result" data-current-pilot-result hidden></div>
</section>
