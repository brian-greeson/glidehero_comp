<section class="info-card viewport-stats" data-personal-stats aria-busy="true">
  <h2>Stats</h2>
  <dl aria-live="polite">
    <div><dt>Claimed Area</dt><dd data-personal-claimed-area>-</dd></div>
    <div><dt>Flights</dt><dd data-personal-flights>-</dd></div>
    <div><dt>% of Visible Map Claimed</dt><dd data-personal-claimed-percentage>-</dd></div>
  </dl>
</section>
