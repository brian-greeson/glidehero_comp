<section class="profile-section" aria-labelledby="profile-progress-heading">
  <header class="profile-section-heading">
    <div>
      <p class="admin-eyebrow">Keep exploring</p>
      <h2 id="profile-progress-heading">In progress</h2>
    </div>
    <span class="profile-section-count">{{ profile.achievementProgress.length }} {{ if profile.achievementProgress.length === 1 }}milestone{{ else }}milestones{{ /if }}</span>
  </header>
  <div class="achievement-progress-list">
    {{ for milestone of profile.achievementProgress }}
      <article class="achievement-progress-card" data-achievement-progress="{{ milestone.key }}">
        {{ include "components/profileAchievementBadge.vto" { achievementType: milestone.achievementType, achievementCategory: milestone.achievementCategory, badgeLabel: milestone.badgeLabel, badgeAriaLabel: milestone.badgeAriaLabel } }}
        <div class="achievement-progress-copy">
          <div class="achievement-progress-heading">
            <div>
              <p>{{ milestone.typeLabel }}</p>
              {{ if milestone.arenaPath }}<h3><a href="{{ milestone.arenaPath }}">{{ milestone.title }}</a></h3>{{ else }}<h3>{{ milestone.title }}</h3>{{ /if }}
            </div>
            <strong>{{ milestone.currentLabel }} / {{ milestone.targetLabel }}</strong>
          </div>
          <p>{{ if profileIsCurrent }}{{ milestone.currentDescription }}{{ else }}{{ milestone.otherDescription }}{{ /if }}</p>
          <div class="achievement-progress-value">
            <progress aria-label="Progress toward {{ milestone.title }}" max="{{ milestone.targetValue }}" value="{{ if milestone.currentValue === 0 }}0{{ else }}{{ milestone.currentValue }}{{ /if }}">{{ milestone.progressPercent }}%</progress>
            <span aria-hidden="true">{{ if milestone.progressPercent === 0 }}0{{ else }}{{ milestone.progressPercent }}{{ /if }}%</span>
          </div>
        </div>
      </article>
    {{ /for }}
  </div>
</section>
