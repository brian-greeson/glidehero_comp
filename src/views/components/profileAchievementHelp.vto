<section class="achievement-help" aria-labelledby="achievement-help-heading">
  <div class="achievement-types">
    <h2 id="achievement-help-heading">Achievement types</h2>
    <div class="achievement-type-list">
      <article>
        {{ include "components/profileAchievementBadge.vto" { achievementType: 'unique_cells_milestone', badgeLabel: '10' } }}
        <div><h3>Unique cell milestones</h3><p>Reach permanent cell milestones on the Personal Map.</p></div>
      </article>
      <article>
        {{ include "components/profileAchievementBadge.vto" { achievementType: 'personal_best_total_cells', badgeLabel: 'PB' } }}
        <div><h3>Total-cell personal bests</h3><p>Set or improve the most cells claimed in one flight.</p></div>
      </article>
      <article>
        {{ include "components/profileAchievementBadge.vto" { achievementType: 'personal_best_enclosed_cells', badgeLabel: 'Loop' } }}
        <div><h3>Enclosed-cell personal bests</h3><p>Set or improve the record for cells enclosed in one flight.</p></div>
      </article>
      <article>
        {{ include "components/profileAchievementBadge.vto" { achievementType: 'special', achievementCategory: 'launch', badgeLabel: '★', badgeAriaLabel: 'Launch Arena achievement' } }}
        <div><h3>Launch Arena achievements</h3><p>Visit Launch Arenas, start your first flight from one, and complete every cell in one.</p></div>
      </article>
      <article>
        {{ include "components/profileAchievementBadge.vto" { achievementType: 'special', achievementCategory: 'leadership', badgeLabel: '★', badgeAriaLabel: 'Arena Leadership achievement' } }}
        <div><h3>Arena leadership achievements</h3><p>Take or reclaim the lead in a General, State, or Country Arena.</p></div>
      </article>
      <article>
        {{ include "components/profileAchievementBadge.vto" { achievementType: 'threshold', achievementCategory: 'general', badgeLabel: '10', badgeAriaLabel: 'General Arena achievement' } }}
        <div><h3>General Arena achievements</h3><p>Claim cells in General Arenas and reach coverage milestones in any one Arena.</p></div>
      </article>
      <article>
        {{ include "components/profileAchievementBadge.vto" { achievementType: 'threshold', achievementCategory: 'state', badgeLabel: '1', badgeAriaLabel: 'State achievement' } }}
        <div><h3>State achievements</h3><p>States Flown in counts a State Arena once you claim at least one cell there.</p></div>
      </article>
      <article>
        {{ include "components/profileAchievementBadge.vto" { achievementType: 'threshold', achievementCategory: 'country', badgeLabel: '1', badgeAriaLabel: 'Country achievement' } }}
        <div><h3>Country achievements</h3><p>Countries Flown in counts a Country Arena once you claim at least one cell there.</p></div>
      </article>
      <article>
        {{ include "components/profileAchievementBadge.vto" { achievementType: 'record', achievementCategory: 'launch', badgeLabel: 'PB', badgeAriaLabel: 'Launch Arena personal-best achievement' } }}
        <div><h3>Launch Arena personal bests</h3><p>Tag distinct Launch Arenas during one flight to establish or improve the record.</p></div>
      </article>
    </div>
  </div>
  <aside class="achievement-how-it-works">
    <span class="achievement-info-icon" aria-hidden="true">i</span>
    <div>
      <h2>How progress works</h2>
      <p>Progress updates after flights are processed. Milestones are earned once, while a new personal best is awarded whenever a pilot sets or improves a record.</p>
    </div>
  </aside>
</section>
