<header class="achievement-hero">
  <div class="achievement-hero-copy">
    <span class="achievement-trophy" aria-hidden="true">★</span>
    <div>
      <p class="achievement-eyebrow">Pilot achievements</p>
      <h1>{{ if profileIsCurrent }}Achievements{{ else }}{{ profile.displayName }}’s Achievements{{ /if }}</h1>
    </div>
  </div>
  <dl class="achievement-summary" aria-label="Achievement summary">
    <div>
      <dt>Achievements earned</dt>
      <dd>{{ if profile.achievementCount === 0 }}0{{ else }}{{ profile.achievementCount }}{{ /if }}</dd>
    </div>
    <div>
      <dt>Unique cells</dt>
      <dd>{{ if profile.lifetimeUniqueCellCount === 0 }}0{{ else }}{{ profile.lifetimeUniqueCellCount }}{{ /if }}</dd>
    </div>
    <div>
      <dt>Next milestone</dt>
      <dd>{{ profile.nextUniqueCellMilestone }}</dd>
    </div>
  </dl>
</header>
{{ if !profileIsCurrent }}
  {{ include "components/followButton.vto" { targetUserId: profile.userId, isFollowing: profileIsFollowed, returnTo: currentPath } }}
{{ /if }}
