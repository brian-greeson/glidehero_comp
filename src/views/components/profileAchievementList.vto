<section class="profile-section" aria-labelledby="profile-achievements-heading">
  <header class="profile-section-heading">
    <div>
      <p class="admin-eyebrow">Achievement history</p>
      <h2 id="profile-achievements-heading">Earned achievements</h2>
    </div>
    <span class="profile-section-count">
      {{ if achievements.length === 50 }}
        {{ if achievementCount > 50 }}Latest 50 of {{ achievementCount }}{{ else }}50 earned{{ /if }}
      {{ else }}
        {{ if achievementCount === 0 }}0{{ else }}{{ achievementCount }}{{ /if }} earned
      {{ /if }}
    </span>
  </header>
  {{ if achievements.length === 0 }}
    <p class="profile-empty-state">No achievements yet.{{ if profileIsCurrent }} Complete a flight to start building your history.{{ /if }}</p>
  {{ else }}
    <ol id="profile-achievement-list" class="profile-achievement-list" data-profile-list>
      {{ for achievement of achievements }}
        <li class="profile-achievement-item">
          {{ include "components/profileAchievementBadge.vto" { achievementType: achievement.achievementType, achievementCategory: achievement.achievementCategory, badgeLabel: achievement.badgeLabel, badgeAriaLabel: achievement.badgeAriaLabel } }}
          <div class="profile-achievement-copy">
            <div class="profile-item-meta">
              <span>{{ achievement.typeLabel }}</span>
              <time>Earned {{ if typeof achievement.earnedTimestamp !== 'undefined' }}{{ achievement.earnedTimestamp }}{{ else }}{{ achievement.earnedDate }}{{ /if }}</time>
            </div>
            <h3>{{ achievement.title }}</h3>
            <p>{{ achievement.description }}</p>
            {{ if achievement.sourceFlightId }}<small>Flight {{ achievement.sourceFlightId }}</small>{{ /if }}
          </div>
          <span class="achievement-earned-mark" aria-hidden="true">✓</span>
        </li>
      {{ /for }}
    </ol>
    {{ if achievements.length > 3 }}
      <button type="button" class="profile-list-toggle" data-profile-list-toggle data-show-all-label="Show all" data-show-fewer-label="Show fewer" aria-controls="profile-achievement-list" aria-expanded="false" hidden>Show all</button>
    {{ /if }}
  {{ /if }}
</section>
