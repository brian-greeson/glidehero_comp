<span class="achievement-badge{{ if achievementType === 'unique_cells_milestone' }} achievement-badge--milestone{{ else if achievementType === 'personal_best_total_cells' }} achievement-badge--total-best{{ else if achievementType === 'personal_best_enclosed_cells' }} achievement-badge--enclosed-best{{ else }} achievement-badge--other{{ /if }}"{{ if typeof badgeAriaLabel !== 'undefined' && badgeAriaLabel }} role="img" aria-label="{{ badgeAriaLabel }}"{{ else }} aria-hidden="true"{{ /if }}>
  <span>{{ badgeLabel }}</span>
</span>
