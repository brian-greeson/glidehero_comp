<span class="achievement-badge{{ if achievementType === 'unique_cells_milestone' }} achievement-badge--milestone{{ else if achievementType === 'personal_best_total_cells' }} achievement-badge--total-best{{ else if achievementType === 'personal_best_enclosed_cells' }} achievement-badge--enclosed-best{{ else }} achievement-badge--other{{ /if }}" aria-hidden="true">
  <span>{{ badgeLabel }}</span>
</span>
