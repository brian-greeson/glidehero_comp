<section class="metric-strip{{ if typeof compact !== 'undefined' && compact }} metric-strip--compact{{ /if }}" aria-label="{{ label }}">
  {{ for metric of metrics }}
    <article class="metric metric--{{ metric.tone }}">
      <span class="metric__icon">{{ include "app/components/icon.vto" { name: metric.icon } }}</span>
      <div><strong>{{ metric.value }}</strong><span>{{ metric.label }}</span>{{ if metric.detail }}<small>{{ metric.detail }}</small>{{ /if }}</div>
    </article>
  {{ /for }}
</section>
