<aside class="map-sidebar" aria-label="Map controls">
  <section class="map-control-group">
    <h2>View</h2>
    <div class="segmented-control map-mode-control" data-segmented-control role="group" aria-label="Map mode">
      <a href="{{ if typeof mapModeHrefs !== 'undefined' }}{{ mapModeHrefs.personal }}{{ else }}/personal{{ /if }}" data-map-mode-link="personal" class="{{ if mode === 'personal' }}is-active{{ /if }}" aria-current="{{ if mode === 'personal' }}page{{ else }}false{{ /if }}">{{ include "authenticated/components/icon.vto" { name: "profile" } }}<span>My Flights</span></a>
      <a href="{{ if typeof mapModeHrefs !== 'undefined' }}{{ mapModeHrefs.following }}{{ else }}/following{{ /if }}" data-map-mode-link="following" class="{{ if mode === 'following' }}is-active{{ /if }}" aria-current="{{ if mode === 'following' }}page{{ else }}false{{ /if }}">{{ include "authenticated/components/icon.vto" { name: "people" } }}<span>Following</span></a>
      <a href="{{ if typeof mapModeHrefs !== 'undefined' }}{{ mapModeHrefs.competitive }}{{ else }}/global{{ /if }}" data-map-mode-link="competitive" class="{{ if mode !== 'personal' && mode !== 'following' }}is-active{{ /if }}" aria-current="{{ if mode !== 'personal' && mode !== 'following' }}page{{ else }}false{{ /if }}">{{ include "authenticated/components/icon.vto" { name: "globe" } }}<span>All Pilots</span></a>
    </div>
  </section>
  <section class="map-control-group">
    <h2>Time Range</h2>
    <div class="map-desktop-period-controls" data-segmented-control role="group" aria-label="Time range">
      <button type="button" data-competition-period-option="all-time" aria-pressed="{{ if period === 'all-time' }}true{{ else }}false{{ /if }}">{{ include "authenticated/components/icon.vto" { name: "calendar" } }}<span>All Time</span></button>
      <div class="map-desktop-month-control">
        <button type="button" data-competition-period-option="current-month" aria-pressed="{{ if period === 'current-month' }}true{{ else }}false{{ /if }}"><span data-current-month-option>Current Month</span></button>
        <div class="map-month-navigation" role="group" aria-label="Month navigation">
          <button type="button" data-competition-month-nav="previous" aria-label="Previous month">‹</button>
          <button type="button" data-competition-month-nav="next" aria-label="Next month">›</button>
        </div>
      </div>
    </div>
    <div class="map-desktop-replay" data-map-replay><button type="button" data-map-replay-open aria-controls="map-replay-panel-desktop" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10H7z"/><path d="M5 4v4h4M19 20v-4h-4M6.5 7A7 7 0 0 1 18 8M17.5 17A7 7 0 0 1 6 16"/></svg><span>Replay month</span></button>{{ include "authenticated/components/mapReplayControls.vto" { panelId: "map-replay-panel-desktop", showSync: true } }}</div>
  </section>
  <section class="map-control-group map-location">
    <h2>Location</h2>
    <div class="map-location__control">
      <button type="button" class="map-location__trigger" data-map-location-trigger aria-controls="arena-search-input" aria-label="{{ if location }}Change location from {{ location }}{{ else }}Select a location{{ /if }}">{{ include "authenticated/components/icon.vto" { name: "pin" } }}<span>{{ if location }}{{ location }}{{ /if }}</span>{{ include "authenticated/components/icon.vto" { name: "chevron-down" } }}</button>
      {{ if location && typeof locationClearHref !== 'undefined' }}<a class="map-location__clear" href="{{ locationClearHref }}" aria-label="Clear location {{ location }}">×</a>{{ /if }}
    </div>
  </section>
  {{ if mode === 'personal' || metrics.length }}
    <section class="map-control-group map-stats">
      <h2>Your Stats</h2>
      <div class="map-stat-grid" data-map-viewport-stats {{ if mode === 'personal' }}data-personal-stats aria-busy="true"{{ /if }}>
        {{ if mode === 'personal' && metrics.length === 0 }}
          <article class="map-stat map-stat--green"><strong data-personal-claimed-cells>—</strong><span>Cells Owned</span></article>
          <article class="map-stat map-stat--blue"><strong data-personal-claimed-area>—</strong><span>Claimed Area</span></article>
          <article class="map-stat map-stat--purple"><strong data-personal-flights>—</strong><span>Flights</span></article>
        {{ else }}
          {{ for metric of metrics }}
            <article class="map-stat map-stat--{{ metric.tone }}"><strong>{{ metric.value }}</strong><span>{{ metric.label }}</span></article>
          {{ /for }}
        {{ /if }}
      </div>
    </section>
  {{ /if }}
  {{ if mode !== 'personal' }}
    {{ include "authenticated/components/mapLeaderboard.vto" { compact: false } }}
  {{ /if }}
</aside>
