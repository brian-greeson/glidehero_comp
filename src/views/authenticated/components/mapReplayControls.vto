<div id="{{ panelId }}" class="map-replay-controls" data-map-replay-panel hidden>
  <p class="map-replay-status" data-map-replay-status role="status"></p>
  <div class="map-replay-controls__bar">
    <button class="map-replay-button map-replay-button--play" type="button" data-map-replay-play disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path data-map-replay-play-icon d="M8 5v14l11-7z"/></svg>
      <span class="sr-only" data-map-replay-play-label>Play</span>
    </button>
    <span class="map-replay-divider" aria-hidden="true"></span>
    <label class="map-replay-speed"><span class="sr-only">Replay speed</span><select data-map-replay-speed disabled><option value="1">1×</option><option value="5">5×</option><option value="60" selected>60×</option><option value="100">100×</option><option value="200">200×</option></select></label>
    {{ if showSync }}<button class="map-replay-sync" type="button" data-map-replay-sync aria-label="Synchronize flight starts" aria-pressed="false" disabled><span>Sync</span></button>{{ /if }}
    <div class="map-replay-progress">
      <span data-map-replay-elapsed>0:00 / 0:00</span>
      <input type="range" data-map-replay-slider min="0" max="0" value="0" step="1" aria-label="Replay position" disabled>
    </div>
    {{ if typeof showClose === "undefined" || showClose }}
      <span class="map-replay-divider" aria-hidden="true"></span>
      <button class="map-replay-button map-replay-button--close" type="button" data-map-replay-close aria-label="Close replay">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    {{ /if }}
  </div>
</div>
