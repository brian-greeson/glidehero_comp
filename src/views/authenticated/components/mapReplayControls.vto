<div id="{{ panelId }}" data-map-replay-panel hidden>
  <p data-map-replay-status role="status"></p>
  <button type="button" data-map-replay-play disabled>Play</button>
  <button type="button" data-map-replay-close>Close</button>
  <label>Speed <select data-map-replay-speed><option value="1">1×</option><option value="5">5×</option><option value="50" selected>50×</option><option value="100">100×</option><option value="200">200×</option></select></label>
</div>
