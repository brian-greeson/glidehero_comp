<dialog id="flight-upload-dialog" class="flight-upload-dialog" data-upload-dialog aria-labelledby="flight-upload-title">
  <section class="flight-upload-panel">
    <header>
      <div>
        <p class="flight-upload-eyebrow">Flight upload</p>
        <h2 id="flight-upload-title">Upload flights</h2>
        <p class="flight-upload-description">Regular uploads must have launched within the last 30 days, based on the launch location's local calendar.</p>
      </div>
      <button type="button" class="flight-upload-close" data-upload-close
        aria-label="Close upload status">&times;</button>
    </header>
    <div class="flight-upload-status">
      <div class="flight-upload-progress" data-upload-progress-state>
        <div><strong>Keep this page open until all files finish uploading.</strong><span data-upload-overall>0/0</span>
        </div>
        <progress max="1" value="0" data-flight-progress-bar></progress>
      </div>
      <div class="flight-processing-state" data-processing-state hidden>
        <strong data-processing-message>Upload successful, this dialog will close in 3 seconds.</strong>
      </div>
    </div>
    <section class="flight-upload-failures" data-upload-failures hidden>
      <h3>Failed uploads</h3>
      <ul data-upload-list></ul>
    </section>
    <footer>
      <label class="flight-upload-action">Choose regular flights<input data-upload-more-input type="file" multiple data-upload-regular-input></label>
      <button type="button" class="flight-upload-action" data-upload-bulk-trigger>Bulk historical flight upload</button>
      <p class="flight-upload-bulk-help" data-upload-bulk-panel hidden>Choose one ZIP containing IGC files of any age. This may take a while; only one bulk update can run at a time.<br><label>Choose ZIP<input data-upload-bulk-input type="file"></label> <button type="button" data-upload-bulk-cancel hidden>Cancel historical upload</button></p>
    </footer>
  </section>
</dialog>
