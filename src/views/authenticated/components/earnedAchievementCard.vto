<article class="earned-achievement-card">
  {{ include "authenticated/components/achievementBadge.vto" { achievement } }}
  <div>
    {{ if achievement.typeLabel }}<span class="achievement-card__type">{{ achievement.typeLabel }}</span>{{ /if }}
    <h3>{{ achievement.title }}</h3>
    <p>{{ achievement.description }}</p>
    {{ if achievement.earnedDate }}<small>{{ include "authenticated/components/icon.vto" { name: "check" } }}Earned {{ achievement.earnedDate }}</small>{{ /if }}
  </div>
</article>
