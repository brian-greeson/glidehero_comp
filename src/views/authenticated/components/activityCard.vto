<article class="activity-card" data-activity-kind="{{ event.kind }}" data-activity-own="{{ if typeof event.isOwn !== 'undefined' }}{{ event.isOwn }}{{ else }}false{{ /if }}">
  <header class="activity-card__pilot">
    {{ include "authenticated/components/initialsAvatar.vto" { initials: event.pilot.initials, color: event.pilot.color } }}
    <div>{{ if typeof event.pilot.href !== 'undefined' && event.pilot.href }}<a href="{{ event.pilot.href }}"><strong>{{ event.pilot.displayName }}</strong></a>{{ else }}<strong>{{ event.pilot.displayName }}</strong>{{ /if }}<time datetime="{{ event.publishedAtIso }}">{{ event.timeAgo }}</time></div>
  </header>
  <div class="activity-card__content">
    <div class="activity-card__copy">
      <h3>{{ event.title }}</h3><p>{{ event.detail }}</p><small>{{ include "authenticated/components/icon.vto" { name: "pin" } }}{{ event.arena }}</small>
      {{ if event.achievements.length }}<div class="activity-card__badges">{{ for achievement of event.achievements }}{{ include "authenticated/components/achievementBadge.vto" { achievement } }}{{ /for }}</div>{{ /if }}
      {{ if event.progress }}<div class="activity-card__challenge"><span>Completed</span>{{ include "authenticated/components/progressBar.vto" { progress: event.progress, label: event.title } }}</div>{{ /if }}
    </div>
    {{ if event.kind === "flight" && event.flight }}<div class="activity-card__flight-media">{{ include "authenticated/components/flightMapPreview.vto" { flight: event.flight } }}{{ if preview }}<div class="activity-card__flight-summary"><strong>{{ event.flight.date }}</strong><span>{{ event.flight.distance }} · {{ event.flight.cells }} cells</span></div>{{ else }}<dl class="activity-card__flight-summary"><div><dt>Flight date</dt><dd>{{ event.flightDate }}</dd></div><div><dt>Duration</dt><dd>{{ event.duration }}</dd></div><div><dt>Distance</dt><dd>{{ event.distance }}</dd></div><div><dt>Cells</dt><dd>{{ if event.totalCellCount === 0 }}0{{ else }}{{ event.totalCellCount }}{{ /if }}</dd></div></dl>{{ /if }}</div>{{ /if }}
  </div>
  <footer>
    {{ if typeof event.activityId !== 'undefined' && event.activityId && !event.isOwn }}
      <form method="post" action="/activities/{{ event.activityId }}/like" class="activity-like-form" data-like-form>
        <button type="submit" class="activity-like-button" data-like-button aria-label="{{ if event.viewerHasLiked }}Like sent{{ else }}Send a Like{{ /if }}" aria-pressed="{{ if event.viewerHasLiked }}true{{ else }}false{{ /if }}">{{ include "authenticated/components/icon.vto" { name: "like", className: "like-icon" } }}<span data-like-label>{{ if event.viewerHasLiked }}Like sent{{ else }}Send a Like{{ /if }}</span><span class="activity-like-count" data-like-count>{{ if event.likeCount === 0 }}0{{ else }}{{ event.likeCount }}{{ /if }}</span></button><span class="activity-like-status" data-like-status aria-live="polite"></span>
      </form>
    {{ else if typeof event.activityId !== 'undefined' && event.activityId }}
      <span class="activity-like-static" aria-label="{{ event.likeCount }} Likes received">{{ include "authenticated/components/icon.vto" { name: "like", className: "like-icon" } }}<span data-like-count>{{ if event.likeCount === 0 }}0{{ else }}{{ event.likeCount }}{{ /if }}</span><span>Likes</span></span>
    {{ /if }}
  </footer>
</article>
