<nav class="map-mobile-controls map-mobile-view-controls" aria-label="Map view">
  <span class="map-mobile-control-heading">View</span>
  <a href="/personal" data-map-mode-link="personal" class="{{ if mode === 'personal' }}is-active{{ /if }}" aria-current="{{ if mode === 'personal' }}page{{ else }}false{{ /if }}">{{ include "authenticated/components/icon.vto" { name: "profile" } }}<span>My Flights</span></a>
  <a href="{{ if mode === 'competitive' }}{{ navigation[0].href }}{{ else }}/global{{ /if }}" data-map-mode-link="competitive" class="{{ if mode === 'competitive' }}is-active{{ /if }}" aria-current="{{ if mode === 'competitive' }}page{{ else }}false{{ /if }}">{{ include "authenticated/components/icon.vto" { name: "globe" } }}<span>All Pilots</span></a>
</nav>
<nav class="map-mobile-period-controls" aria-label="Time period">
  <button type="button" data-competition-period-option="all-time" aria-pressed="{{ if period === 'all-time' }}true{{ else }}false{{ /if }}">{{ include "authenticated/components/icon.vto" { name: "calendar" } }}<span>All Time</span></button>
  <div class="map-mobile-month-control">
    <button type="button" data-competition-period-option="current-month" aria-pressed="{{ if period === 'current-month' }}true{{ else }}false{{ /if }}"><span data-current-month-option>Current Month</span></button>
    <div class="map-mobile-month-navigation" role="group" aria-label="Month navigation">
      <button type="button" data-competition-month-nav="previous" aria-label="Previous month">‹</button>
      <button type="button" data-competition-month-nav="next" aria-label="Next month">›</button>
    </div>
  </div>
</nav>
