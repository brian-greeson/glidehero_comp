<section class="personal-history" data-personal-history
  data-summary-endpoint="/v1/personal-history/summary"
  aria-label="Personal flying history">
  <dl class="personal-history__summary">
    <div><dt>Total flights</dt><dd data-personal-summary="totalFlights">0</dd></div>
    <div><dt>Distance flown</dt><dd data-personal-summary="fivePointDistanceMeters">0 km</dd></div>
    <div><dt>Airtime</dt><dd data-personal-summary="airtimeSeconds">0m</dd></div>
    <div><dt>Launches visited</dt><dd data-personal-summary="launchesVisited">0</dd></div>
    <div><dt>Countries visited</dt><dd data-personal-summary="countriesVisited">0</dd></div>
  </dl>
  <p data-personal-history-status role="status" hidden></p>
</section>
