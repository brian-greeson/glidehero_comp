<section class="profile-card profile-card--flights" data-profile-always-open>
  <header class="section-heading"><div>{{ include "authenticated/components/icon.vto" { name: "flight" } }}<h2>Recent Flights</h2></div></header>
  <div class="profile-card__desktop-content">
    {{ if flights.length }}{{ include "authenticated/components/flightTable.vto" { flights } }}
    {{ else }}<p class="profile-empty">No completed flights yet.</p>{{ /if }}
  </div>
</section>
