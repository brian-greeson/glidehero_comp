<section class="achievement-types-card">
  {{ include "authenticated/components/sectionHeading.vto" { title: "Achievement Types" } }}
  <div class="achievement-type-grid">
    <article>{{ include "authenticated/components/icon.vto" { name: "milestone" } }}<div><h3>Milestones</h3><p>Reach unique-cell milestones on your Personal Map.</p></div></article>
    <article>{{ include "authenticated/components/icon.vto" { name: "mountain" } }}<div><h3>Personal Bests</h3><p>Set or improve a record in a specific flight category.</p></div></article>
    <article>{{ include "authenticated/components/icon.vto" { name: "globe" } }}<div><h3>Exploration</h3><p>Discover and explore Arenas across the world.</p></div></article>
    <article>{{ include "authenticated/components/icon.vto" { name: "special" } }}<div><h3>Special</h3><p>Unique achievements for adventurous accomplishments.</p></div></article>
  </div>
  <aside><strong>How progress works</strong><p>Progress updates automatically as flights are processed. Achievements are awarded when milestones are reached.</p></aside>
</section>
