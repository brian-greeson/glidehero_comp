<section class="{{ if typeof compact !== 'undefined' && compact }}map-leaderboard map-leaderboard--coverage map-leaderboard--compact{{ else }}map-control-group map-leaderboard map-leaderboard--coverage{{ /if }}" data-territory-leaderboard data-territory-leaderboard-variant="{{ if typeof compact !== 'undefined' && compact }}compact{{ else }}full{{ /if }}" aria-busy="true">
  <header class="map-leaderboard__heading">
    <h2>{{ if typeof compact !== 'undefined' && compact }}{{ include "authenticated/components/icon.vto" { name: "trophy" } }}{{ /if }}Viewport Leaderboard</h2>
    <button type="button" data-territory-allpilots aria-pressed="true">Show All{{ if typeof compact !== 'undefined' && compact }}{{ include "authenticated/components/icon.vto" { name: "chevron-right" } }}{{ /if }}</button>
  </header>
  <p class="leaderboard-status" data-territory-status aria-live="polite">Loading coverage…</p>
  <div class="coverage-table" role="table" aria-label="Coverage leaders"><div data-territory-list role="rowgroup"></div></div>
  {{ if typeof compact === 'undefined' || !compact }}
    <div class="current-pilot-result" data-territory-current-pilot hidden></div>
  {{ /if }}
</section>
