<article class="selected-flight">
  <header><span>{{ include "authenticated/components/icon.vto" { name: "flight" } }}Selected Flight</span><button type="button" aria-label="Delete selected flight">{{ include "authenticated/components/icon.vto" { name: "trash" } }}</button></header>
  <div class="selected-flight__pilot">
    {{ include "authenticated/components/initialsAvatar.vto" { initials: flight.pilot.initials, color: flight.pilot.color } }}
    <div><strong>{{ flight.pilot.displayName }}</strong><span>{{ flight.date }}</span></div>
    {{ include "authenticated/components/icon.vto" { name: "chevron-right" } }}
  </div>
  <dl>
    <div><dt>{{ include "authenticated/components/icon.vto" { name: "activity" } }}Distance</dt><dd>{{ flight.distance }}</dd></div>
    <div><dt>{{ include "authenticated/components/icon.vto" { name: "cell" } }}Cells Claimed</dt><dd>{{ flight.cells }}</dd></div>
    <div><dt>{{ include "authenticated/components/icon.vto" { name: "trophy" } }}Achievements</dt><dd>{{ flight.achievements }}</dd></div>
  </dl>
  <a class="primary-action" href="#flight-details">View Flight Details{{ include "authenticated/components/icon.vto" { name: "chevron-right" } }}</a>
</article>
