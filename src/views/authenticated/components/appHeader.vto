<header class="app-header{{ if page === 'map' }} app-header--map{{ /if }}">
  {{ for item of navigation }}{{ if item.page === 'map' }}<a class="app-brand" href="{{ item.href }}" aria-label="Glide Hero Map">{{ /if }}{{ /for }}
    <img src="/android-chrome-192x192.png" alt="">
    <span class="app-brand__wordmark"><strong>GLIDE</strong><strong>HERO</strong></span>
  </a>
  <nav class="desktop-navigation" aria-label="Primary navigation">
    {{ for item of navigation }}
      <a class="desktop-navigation__item{{ if item.page === activeNavigationPage }} is-active{{ /if }}" href="{{ item.href }}"{{ if item.page === activeNavigationPage && page !== 'group' }} aria-current="page"{{ /if }}>
        {{ include "authenticated/components/icon.vto" { name: item.icon } }}<span>{{ item.label }}</span>
      </a>
    {{ /for }}
  </nav>
  {{ if page === 'map' }}{{ include "authenticated/components/launchSelector.vto" }}{{ /if }}
  <div class="app-header__actions">
    <button class="app-upload-trigger" type="button" data-upload-trigger aria-controls="flight-upload-dialog">
    <span>Upload</span>
    </button>
    <div class="app-account" data-app-account>
      <button class="app-account__trigger" type="button" data-account-trigger aria-expanded="false" aria-controls="app-account-menu" aria-label="Open account menu for {{ user.displayName }}">
        {{ include "authenticated/components/initialsAvatar.vto" { initials: user.initials, size: "header" } }}
        {{ include "authenticated/components/icon.vto" { name: "chevron-down" } }}
      </button>
      <div class="app-account__menu" id="app-account-menu" data-account-menu hidden>
        {{ if typeof gettingStarted !== 'undefined' && gettingStarted }}
          {{ if gettingStarted.dismissed }}
            <form method="post" action="/onboarding/restore" data-onboarding-restore-form><button type="submit">{{ include "authenticated/components/icon.vto" { name: "star" } }}Restore getting started</button></form>
          {{ else }}
            <a href="/activity">{{ include "authenticated/components/icon.vto" { name: "star" } }}Getting started</a>
          {{ /if }}
        {{ /if }}
        <a href="{{ donateUrl }}">{{ include "authenticated/components/icon.vto" { name: "heart" } }}Donate</a>
        {{ if user.isAdmin }}<a href="{{ adminUrl }}">{{ include "authenticated/components/icon.vto" { name: "shield" } }}Admin</a>{{ /if }}
        <form method="post" action="{{ logoutUrl }}"><button type="submit">{{ include "authenticated/components/icon.vto" { name: "logout" } }}Log out</button></form>
      </div>
    </div>
  </div>
</header>
