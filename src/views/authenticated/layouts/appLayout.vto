<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="stylesheet" href="/styles/app-ui/tokens.css">
    <link rel="stylesheet" href="/styles/app-ui/app.css">
    <link rel="stylesheet" href="/styles/app-ui/flight-thumbnails.css">
    {{ if page === 'map' || page === 'flight' }}<link rel="stylesheet" href="/styles/app-ui/replay.css">{{ /if }}
    <link rel="stylesheet" href="{{ pageStylesheet }}">
    {{ if page === 'map' || page === 'plan' || page === 'flight' || page === 'group' }}<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.16.0/dist/maplibre-gl.css">{{ /if }}
    {{ if isGuest }}<meta name="robots" content="noindex, nofollow">{{ /if }}
    {{ if typeof socialPreview !== 'undefined' && socialPreview }}
      <meta name="description" content="{{ socialPreview.description }}">
      <link rel="canonical" href="{{ socialPreview.canonicalUrl }}">
      <meta property="og:type" content="website">
      <meta property="og:site_name" content="GlideHero">
      <meta property="og:title" content="{{ title }}">
      <meta property="og:description" content="{{ socialPreview.description }}">
      <meta property="og:url" content="{{ socialPreview.canonicalUrl }}">
      <meta property="og:image" content="{{ socialPreview.imageUrl }}">
      <meta property="og:image:type" content="image/webp">
      <meta property="og:image:width" content="{{ socialPreview.imageWidth }}">
      <meta property="og:image:height" content="{{ socialPreview.imageHeight }}">
      <meta property="og:image:alt" content="{{ socialPreview.imageAlt }}">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:title" content="{{ title }}">
      <meta name="twitter:description" content="{{ socialPreview.description }}">
      <meta name="twitter:image" content="{{ socialPreview.imageUrl }}">
      <meta name="twitter:image:alt" content="{{ socialPreview.imageAlt }}">
    {{ /if }}
    <title>{{ title }}</title>
  </head>
  <body class="app-ui-body app-ui-body--{{ page }}{{ if isGuest }} app-ui-body--guest{{ /if }}">
    <div class="app-ui-frame" data-app-page="{{ page }}">
      {{ if isGuest }}
        {{ include "authenticated/components/publicFlightHeader.vto" }}
      {{ else }}
        {{ include "authenticated/components/appHeader.vto" { page, activeNavigationPage, user, navigation, donateUrl, adminUrl, logoutUrl, gettingStarted: typeof gettingStarted !== 'undefined' ? gettingStarted : undefined } }}
      {{ /if }}
      <main class="app-ui-main app-ui-main--{{ page }}" id="main-content">
        {{ content }}
      </main>
      {{ if showFooter }}{{ include "authenticated/components/appFooter.vto" }}{{ /if }}
      {{ if !isGuest }}
        {{ include "authenticated/components/mobileBottomNav.vto" { page, activeNavigationPage, navigation } }}
        {{ include "authenticated/components/flightUploadDialog.vto" }}
      {{ /if }}
      {{ if page === 'activity' && typeof onboarding !== 'undefined' && onboarding && onboarding.selectedStep }}{{ include "authenticated/components/onboardingInstructionDialog.vto" { step: onboarding.selectedStep } }}{{ /if }}
    </div>
    {{ if page === 'map' || page === 'plan' || page === 'flight' || page === 'group' }}<script src="https://unpkg.com/maplibre-gl@5.16.0/dist/maplibre-gl.js"></script>{{ /if }}
    {{ if !isGuest }}<script type="module" src="/scripts/app-ui/app.js"></script>{{ /if }}
    {{ if pageScript }}<script type="module" src="{{ pageScript }}"></script>{{ /if }}
  </body>
</html>
