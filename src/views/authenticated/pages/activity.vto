{{ layout "authenticated/layouts/appLayout.vto" }}
  <div class="mountain-band mountain-band--short" aria-hidden="true"></div>
  <section class="content-page activity-page">
    <div class="activity-layout">
      {{ include "authenticated/components/activityPilotSearch.vto" { activitySearch, activityPilotResults, activityReturnTo, activityScope } }}
      <section class="activity-feed-panel">
        <nav class="pill-filters" role="group" aria-label="Activity filter">
          <a href="{{ if typeof activityScopeLinks !== 'undefined' }}{{ activityScopeLinks.following }}{{ else }}/activity?scope=following{{ /if }}" aria-current="{{ if activityScope === 'following' }}page{{ else }}false{{ /if }}">Following</a>
          <a href="{{ if typeof activityScopeLinks !== 'undefined' }}{{ activityScopeLinks.yours }}{{ else }}/activity?scope=yours{{ /if }}" aria-current="{{ if activityScope === 'yours' }}page{{ else }}false{{ /if }}">My activity</a>
        </nav>
        {{ if typeof onboarding !== 'undefined' && onboarding && !onboarding.dismissed && !onboarding.allComplete }}{{ include "authenticated/components/onboardingCard.vto" { onboarding } }}{{ /if }}
        {{ include "authenticated/components/sectionHeading.vto" { title: "Recent Activity" } }}
        <div class="activity-feed" data-activity-feed>
          {{ for event of events }}{{ include "authenticated/components/activityCard.vto" { event } }}{{ /for }}
          {{ if typeof activityLoadMoreHref !== 'undefined' && activityLoadMoreHref }}
            <a class="activity-load-more" data-activity-load-more data-fragment-href="{{ activityLoadMoreEndpoint }}" href="{{ activityLoadMoreHref }}">Load more activity</a>
            <p class="activity-load-more-status" data-activity-load-more-status aria-live="polite"></p>
          {{ /if }}
          {{ if events.length === 0 }}
            <div class="activity-empty-feed" data-activity-empty>
              {{ if activityScope === 'following' }}<strong>Follow pilots to see their achievements and recent flights.</strong><a href="#activity-pilot-query">Find pilots</a>
              {{ else }}<strong>Your completed recent flights and achievements will appear here.</strong><button type="button" data-upload-trigger data-upload-mode="recent">Upload a flight</button>{{ /if }}
            </div>
          {{ /if }}
        </div>
      </section>
      <aside class="activity-rail">
        <section class="rail-card activity-stats-card" data-activity-stats aria-labelledby="activity-statistics-title">
          <h2 class="sr-only" id="activity-statistics-title">Statistics</h2>
          <header class="activity-stats-card__header">
            <div class="activity-stats-card__periods" role="group" aria-label="Statistics period">
              <button type="button" id="activity-stats-monthly-button" data-activity-stats-button="monthly" aria-controls="activity-stats-monthly" aria-pressed="true">Monthly</button>
              <button type="button" id="activity-stats-daily-button" data-activity-stats-button="daily" aria-controls="activity-stats-daily" aria-pressed="false">Daily</button>
            </div>
          </header>
          <div id="activity-stats-monthly" class="activity-stats-card__period" data-activity-stats-panel="monthly" aria-labelledby="activity-stats-monthly-button">
            <div class="activity-stats-card__grid">
              <div class="activity-stat-tile activity-stat-tile--count">
                <span><span class="activity-stat-tile__label">Flights</span><strong>{{ activityStats.monthly.flightCount }}</strong></span>
              </div>
              {{ include "authenticated/components/activityStatisticWinner.vto" { label: "Most territory in one flight", kind: "territory", winner: activityStats.monthly.mostCells } }}
              {{ include "authenticated/components/activityStatisticWinner.vto" { label: "Most achievements in one flight", kind: "achievements", winner: activityStats.monthly.mostAccomplishments } }}
              {{ include "authenticated/components/activityStatisticWinner.vto" { label: "Longest 5 point flight", kind: "distance", winner: activityStats.monthly.greatestFivePointDistance } }}
            </div>
          </div>
          <div id="activity-stats-daily" class="activity-stats-card__period" data-activity-stats-panel="daily" aria-labelledby="activity-stats-daily-button" hidden>
            <div class="activity-stats-card__grid">
              <div class="activity-stat-tile activity-stat-tile--count">
                <span><span class="activity-stat-tile__label">Flights</span><strong>{{ activityStats.daily.flightCount }}</strong></span>
              </div>
              {{ include "authenticated/components/activityStatisticWinner.vto" { label: "Most territory in one flight", kind: "territory", winner: activityStats.daily.mostCells } }}
              {{ include "authenticated/components/activityStatisticWinner.vto" { label: "Most achievements in one flight", kind: "achievements", winner: activityStats.daily.mostAccomplishments } }}
              {{ include "authenticated/components/activityStatisticWinner.vto" { label: "Longest 5 point flight", kind: "distance", winner: activityStats.daily.greatestFivePointDistance } }}
            </div>
          </div>
        </section>
      </aside>
    </div>
  </section>
  {{ if typeof onboardingDismissedNotice !== 'undefined' && onboardingDismissedNotice }}
    <aside class="onboarding-hidden-notice" data-onboarding-hidden-notice role="status"><div><strong>Getting started hidden</strong><span>You can restore it any time from the account menu.</span></div><form method="post" action="/onboarding/restore" data-onboarding-restore-form><button type="submit">Undo</button></form><button type="button" data-onboarding-notice-close aria-label="Close">&times;</button></aside>
  {{ /if }}
{{ /layout }}
