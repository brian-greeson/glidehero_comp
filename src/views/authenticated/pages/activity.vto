{{ layout "authenticated/layouts/appLayout.vto" }}
  <div class="mountain-band" aria-hidden="true"></div>
  <section class="content-page activity-page">
    <div class="activity-layout">
      <section class="activity-feed-panel">
        {{ include "authenticated/components/activityPilotSearch.vto" { activitySearch, activityPilotResults, activityReturnTo, activityScope } }}
        <nav class="pill-filters" role="group" aria-label="Activity filter">
          <a href="{{ if typeof activityScopeLinks !== 'undefined' }}{{ activityScopeLinks.all }}{{ else }}/activity{{ /if }}" aria-current="{{ if activityScope === 'all' || typeof activityScope === 'undefined' }}page{{ else }}false{{ /if }}">All</a>
          <a href="{{ if typeof activityScopeLinks !== 'undefined' }}{{ activityScopeLinks.following }}{{ else }}/activity?scope=following{{ /if }}" aria-current="{{ if activityScope === 'following' }}page{{ else }}false{{ /if }}">Following</a>
          <a href="{{ if typeof activityScopeLinks !== 'undefined' }}{{ activityScopeLinks.yours }}{{ else }}/activity?scope=yours{{ /if }}" aria-current="{{ if activityScope === 'yours' }}page{{ else }}false{{ /if }}">Yours</a>
        </nav>
        {{ include "authenticated/components/sectionHeading.vto" { title: "Recent Activity", action: "View All", actionId: "all-activity" } }}
        <div class="activity-feed" data-activity-feed>
          {{ for event of events }}{{ include "authenticated/components/activityCard.vto" { event } }}{{ /for }}
          {{ if typeof activityLoadMoreHref !== 'undefined' && activityLoadMoreHref }}
            <a class="activity-load-more" data-activity-load-more data-fragment-href="{{ activityLoadMoreEndpoint }}" href="{{ activityLoadMoreHref }}">Load more activity</a>
            <p class="activity-load-more-status" data-activity-load-more-status aria-live="polite"></p>
          {{ /if }}
          {{ if events.length === 0 }}<p class="activity-empty-feed" data-activity-empty>Nothing to show yet.</p>{{ /if }}
        </div>
      </section>
    </div>
  </section>
{{ /layout }}
