{{ layout "authenticated/layouts/appLayout.vto" }}
  <div class="mountain-band mountain-band--short" aria-hidden="true"></div>
  <section class="content-page achievements-page">
    {{ include "authenticated/components/metricStrip.vto" { metrics, label: "Achievement summary" } }}
    <div class="achievements-layout">
      <div class="achievements-main">
        <section class="achievement-section">
          {{ include "authenticated/components/sectionHeading.vto" { title: "In Progress Achievements", icon: "progress", action: "View All In Progress", actionId: "progress" } }}
          <div class="progress-achievement-grid" data-achievements-list="progress">{{ for achievement of inProgress }}{{ include "authenticated/components/progressAchievementCard.vto" { achievement } }}{{ /for }}</div>
          {{ if inProgress.length === 0 }}<p class="achievement-empty-state">You have no unfinished achievements right now. Keep soaring!</p>{{ /if }}
        </section>
        <section class="achievement-section">
          <header class="section-heading">
            <div>{{ include "authenticated/components/icon.vto" { name: "check" } }}<h2>Earned Achievements</h2></div>
            {{ if earnedHasExtras }}<button type="button" class="achievement-list-toggle" data-achievement-list-toggle="earned" aria-controls="earned-achievements" aria-expanded="false">Show all</button>{{ /if }}
          </header>
          <div class="earned-achievement-grid" id="earned-achievements" data-achievement-list="earned">{{ for achievement of earned }}<div data-achievement-list-item="{{ if achievement.isInitiallyVisible }}visible{{ else }}extra{{ /if }}">{{ include "authenticated/components/earnedAchievementCard.vto" { achievement } }}</div>{{ /for }}</div>
          {{ if earned.length === 0 }}<p class="achievement-empty-state">No achievements earned yet. Complete a flight to start your collection.</p>{{ /if }}
        </section>
      </div>
      <aside class="achievement-rail">
        <section class="rail-card rail-progress">
          {{ include "authenticated/components/sectionHeading.vto" { title: "In Progress", action: "View All", actionId: "rail-progress" } }}
          <div>{{ for achievement of inProgress }}{{ include "authenticated/components/progressAchievementCard.vto" { achievement } }}{{ /for }}</div>
          {{ if inProgress.length === 0 }}<p class="achievement-empty-state">Nothing in progress.</p>{{ /if }}
        </section>
        <section class="rail-card recently-earned">
          {{ include "authenticated/components/sectionHeading.vto" { title: "Recently Earned", action: "View All", actionId: "recent" } }}
          <div>{{ for achievement of recentlyEarned }}{{ include "authenticated/components/earnedAchievementCard.vto" { achievement } }}{{ /for }}</div>
          {{ if recentlyEarned.length === 0 }}<p class="achievement-empty-state">No recently earned achievements.</p>{{ /if }}
        </section>
      </aside>
    </div>
    {{ include "authenticated/components/achievementTypes.vto" }}
  </section>
{{ /layout }}
