{{ layout "authenticated/layouts/appLayout.vto" }}
  <section class="plan-page{{ if activePlan && activePlan.isOwner === false }} plan-page--read-only{{ /if }}" data-plan-page data-plan-authenticated="{{ if isGuest }}false{{ else }}true{{ /if }}" data-plan-read-only="{{ if activePlan && activePlan.isOwner === false }}true{{ else }}false{{ /if }}" data-plan-bootstrap="{{ planBootstrapJson }}">
    <section class="plan-map-stage" aria-label="Flight planning map">
      <div class="plan-map" data-plan-map
        data-map-style-url="{{ mapStyleUrl }}"
        data-thermal-tile-url="{{ thermalTileUrl }}"></div>
    </section>
    <aside class="plan-panel" aria-label="Flight plan controls">
      <div class="plan-heading">
        <p class="plan-eyebrow">Thermal-guided planning</p>
        <h1>Plan your next flight</h1>
        <p class="plan-intro">Click the map to place fixed route points. GlideHero will favor historical thermal activity according to your routing priority.</p>
      </div>
      {{ if activePlan && activePlan.isOwner === false }}
      <section class="plan-viewer-card" aria-label="Shared Plan">
        <span class="plan-read-only-badge">Read-only</span>
        <strong>{{ activePlan.name }}</strong>
        <small>{{ if activePlan.visibility === 'group' }}Shared with your Group{{ else }}Shared with you by link{{ /if }}</small>
      </section>
      {{ else }}
      {{ include "authenticated/components/planSaveShareSheet.vto" }}
      {{ /if }}
      <fieldset class="plan-priority">
        <legend>Routing priority</legend>
        <div role="radiogroup" aria-describedby="plan-priority-help">
          <label><input type="radio" name="routing-priority" value="shorter" data-plan-priority {{ if defaultRoutingPriority === 'shorter' }}checked{{ /if }}{{ if activePlan && activePlan.isOwner === false }} disabled{{ /if }}><span>Shorter</span></label>
          <label><input type="radio" name="routing-priority" value="balanced" data-plan-priority {{ if defaultRoutingPriority === 'balanced' }}checked{{ /if }}{{ if activePlan && activePlan.isOwner === false }} disabled{{ /if }}><span>Balanced</span></label>
          <label><input type="radio" name="routing-priority" value="thermal" data-plan-priority {{ if defaultRoutingPriority === 'thermal' }}checked{{ /if }}{{ if activePlan && activePlan.isOwner === false }} disabled{{ /if }}><span>More thermal</span></label>
        </div>
        <small id="plan-priority-help">Choose how strongly the optimized route trades distance for historical thermal activity.</small>
      </fieldset>
      <div class="plan-bottom-controls">
        <div class="plan-mode-row">
          <label class="plan-priority-mobile">
            <span class="plan-priority-icon" aria-hidden="true">{{ include "authenticated/components/icon.vto" { name: "sliders" } }}</span>
            <select data-plan-priority-mobile aria-label="Routing priority"{{ if activePlan && activePlan.isOwner === false }} disabled{{ /if }}>
              <option value="shorter" {{ if defaultRoutingPriority === 'shorter' }}selected{{ /if }}>Shorter</option>
              <option value="balanced" {{ if defaultRoutingPriority === 'balanced' }}selected{{ /if }}>Balanced</option>
              <option value="thermal" {{ if defaultRoutingPriority === 'thermal' }}selected{{ /if }}>More thermal</option>
            </select>
          </label>
          <p class="plan-status-mobile" data-plan-status-mobile role="status">Place 2 points</p>
        </div>
        <div class="plan-action-bar">
          <div class="plan-actions"{{ if activePlan && activePlan.isOwner === false }} hidden{{ /if }}>
            <button type="button" data-plan-undo disabled aria-label="Undo point"><span class="plan-action-icon" aria-hidden="true">{{ include "authenticated/components/icon.vto" { name: "undo" } }}</span><span>Undo</span></button>
            <button type="button" data-plan-delete disabled aria-label="Delete selected point"><span class="plan-action-icon" aria-hidden="true">{{ include "authenticated/components/icon.vto" { name: "trash" } }}</span><span>Delete</span></button>
            <button type="button" data-plan-reset disabled aria-label="Reset route"><span class="plan-action-icon" aria-hidden="true">{{ include "authenticated/components/icon.vto" { name: "reset" } }}</span><span>Reset</span></button>
          </div>
          <button class="plan-export-trigger" type="button" data-plan-export-open aria-controls="plan-export-dialog" disabled><span aria-hidden="true">{{ include "authenticated/components/icon.vto" { name: "download" } }}</span>Export</button>
        </div>
      </div>
      <div class="plan-map-tools">
        <button class="plan-fit-route" type="button" data-plan-fit-route disabled aria-label="Fit route on map">{{ include "authenticated/components/icon.vto" { name: "target" } }}</button>
        <label class="plan-thermal-toggle"><input type="checkbox" data-plan-thermal-toggle checked><span class="plan-thermal-icon" aria-hidden="true">{{ include "authenticated/components/icon.vto" { name: "thermal" } }}</span><span class="plan-thermal-label">Show historical thermal activity</span></label>
      </div>
      <section class="plan-metrics" data-plan-metrics aria-label="Route metrics">
        <button class="plan-metrics-toggle" type="button" data-plan-metrics-toggle aria-expanded="true" aria-controls="plan-metrics-details">
          <span><small>Optimized route</small><strong data-plan-route-distance>—</strong></span>
          <span class="plan-metrics-chevron" aria-hidden="true"></span>
        </button>
        <dl class="plan-summary" id="plan-metrics-details">
          <div><dt>Direct distance</dt><dd data-plan-direct-distance>—</dd></div>
          <div><dt>Extra distance</dt><dd data-plan-extra-distance>—</dd></div>
          <div><dt>Maximum route</dt><dd data-plan-maximum-distance>—</dd></div>
        </dl>
      </section>
      <p class="plan-status" data-plan-status role="status">Place at least two points to calculate a route.</p>
      <p class="plan-attribution">Historical thermal activity: <a href="https://thermal.kk7.ch/">thermal.kk7.ch</a> · <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a></p>
    </aside>
  </section>
  {{ include "authenticated/components/planExportDialog.vto" }}
  {{ if isGuest }}{{ include "components/planAuthDialog.vto" }}{{ /if }}
{{ /layout }}
