{{ layout "authenticated/layouts/appLayout.vto" }}
  <section class="flight-detail-page">
    <aside class="flight-detail-panel mobile-map-sheet" data-map-sheet aria-label="Flight details">
      <button class="mobile-map-sheet__handle" type="button" data-map-sheet-handle aria-expanded="false" aria-controls="flight-detail-panel-content"><span></span><span class="sr-only" data-map-sheet-label>Expand flight details</span></button>
      {{ include "authenticated/components/flightDetailQuickStats.vto" { flight } }}
      <div class="mobile-map-sheet__content" id="flight-detail-panel-content">
        {{ include "authenticated/components/flightDetailPanel.vto" { flight } }}
      </div>
    </aside>
    <section class="flight-detail-map-stage" aria-label="Flight map">
      <div class="flight-detail-map" data-flight-detail-map
        data-map-style-url="{{ if typeof flight.mapStyleUrl !== 'undefined' }}{{ flight.mapStyleUrl }}{{ /if }}"
        data-map-data-url="{{ flight.mapDataUrl }}"
        data-territory-color="{{ flight.territoryColor }}"
        data-default-distance="{{ flight.defaultDistance }}"></div>
      <div data-map-replay class="map-mobile-replay flight-detail-replay-mobile"><button type="button" data-map-replay-open aria-controls="flight-map-replay-panel-mobile" aria-expanded="false" disabled>Replay</button>{{ include "authenticated/components/mapReplayControls.vto" { panelId: "flight-map-replay-panel-mobile", showSync: false } }}</div>
      <p class="flight-detail-map-status" data-flight-map-status aria-live="polite">Loading flight map…</p>
    </section>
  </section>
{{ /layout }}
