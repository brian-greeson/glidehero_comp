{{ layout "authenticated/layouts/appLayout.vto" }}
  <section class="group-page" data-group-page data-group-id="{{ group.id }}" data-group-month="{{ group.month }}" data-group-flights-url="/v1/groups/{{ group.id }}/flights" data-selected-flight-id="{{ if typeof selectedFlightId !== 'undefined' }}{{ selectedFlightId }}{{ /if }}" data-map-style-url="{{ if typeof mapStyleUrl !== 'undefined' }}{{ mapStyleUrl }}{{ /if }}" data-tile-url="{{ if typeof tileUrl !== 'undefined' }}{{ tileUrl }}{{ /if }}" data-territory-tile-minimum-zoom="{{ if typeof territoryTileMinimumZoom !== 'undefined' }}{{ territoryTileMinimumZoom }}{{ else }}4{{ /if }}" data-territory-tile-maximum-zoom="{{ if typeof territoryTileMaximumZoom !== 'undefined' }}{{ territoryTileMaximumZoom }}{{ else }}14{{ /if }}">
    <header class="group-identity-card">
      <div class="group-mark group-mark--large" aria-hidden="true">{{ include "authenticated/components/icon.vto" { name: "people" } }}</div>
      <div class="group-identity-copy"><p class="group-eyebrow">{{ group.monthLabel }} · Private group</p><h1>{{ group.name }}</h1><p class="group-members">{{ group.memberCount }} of {{ group.capacity }} members</p></div>
      <div class="group-header-actions">
        {{ if group.isOwner && group.inviteHref }}<a class="group-button group-button--quiet" href="{{ group.inviteHref }}">{{ include "authenticated/components/icon.vto" { name: "people" } }}Invite pilots</a>{{ /if }}
        {{ if !group.isOwner && group.leaveHref }}<form method="post" action="{{ group.leaveHref }}"><button class="group-button group-button--quiet" type="submit">Leave</button></form>{{ /if }}
      </div>
    </header>
    <div class="group-content-grid">
      <section class="group-map-card" aria-label="Group territory map">
        <div class="group-map-canvas" data-group-map data-group-id="{{ group.id }}" data-group-month="{{ group.month }}" data-group-flights-url="/v1/groups/{{ group.id }}/flights" data-tile-url="{{ if typeof tileUrl !== 'undefined' }}{{ tileUrl }}{{ /if }}" data-group-pilot-colors="{{ if typeof pilotColorsJson !== 'undefined' }}{{ pilotColorsJson }}{{ else }}{}{{ /if }}" data-territory-tile-minimum-zoom="0" data-territory-tile-maximum-zoom="22"></div>
        {{ if typeof selectedPilotName !== 'undefined' && selectedPilotName }}<div class="group-map-filter"><span>{{ selectedPilotName }}</span><a href="{{ clearFilterHref }}" data-group-clear-pilot aria-label="Show all group members">×</a></div><a class="group-map-all-members" href="{{ clearFilterHref }}" data-group-clear-pilot>All members</a>{{ /if }}
        <p class="group-map-empty" data-group-map-empty hidden>Map unavailable. Flight and standings lists remain available.</p>
      </section>
      <section class="group-card group-standings-card">
        <header class="section-heading"><div>{{ include "authenticated/components/icon.vto" { name: "trophy" } }}<h2>Monthly standings</h2></div></header>
        <div class="group-standings-scroll"><table class="group-standings"><thead><tr><th>Rank</th><th>Pilot</th><th>Cells</th><th>Best distance</th></tr></thead><tbody>{{ for row of standings }}<tr class="{{ if row.isCurrent }}is-current{{ /if }}{{ if typeof selectedPilotId !== 'undefined' && row.userId === selectedPilotId }} is-selected{{ /if }}"><td>{{ if row.rank !== null }}{{ row.rank }}{{ else }}Not ranked yet{{ /if }}</td><td><a href="{{ if row.filterHref }}{{ row.filterHref }}{{ else }}#{{ /if }}" class="group-pilot" data-group-pilot-filter data-group-pilot-id="{{ row.userId }}"><span class="group-pilot-avatar group-pilot-avatar--standing" style="--pilot-color: {{ row.color }}">{{ row.initials }}</span><span>{{ row.displayName }}</span></a></td><td>{{ row.cells }}</td><td>{{ row.fivePointDistance }}{{ if row.isDistanceLeader }} 🏆{{ /if }}</td></tr>{{ /for }}</tbody></table></div>
        {{ if typeof standingsLoadMoreHref !== 'undefined' }}<a class="group-button group-button--quiet" href="{{ standingsLoadMoreHref }}" data-group-standings-load-more>View more</a>{{ /if }}
      </section>
    </div>
    <section class="group-card group-flights-card">
      <header class="section-heading"><div>{{ include "authenticated/components/icon.vto" { name: "flight" } }}<h2>Group flights</h2></div>{{ if typeof selectedPilotName !== 'undefined' && selectedPilotName }}<a class="group-clear-filter" href="{{ clearFilterHref }}">Show all members</a>{{ /if }}</header>
      <p class="group-flights-period">{{ if typeof selectedPilotName !== 'undefined' && selectedPilotName }}{{ selectedPilotName }} · {{ /if }}{{ group.monthLabel }}</p>
      {{ if flights.length }}<div class="group-flights-list">{{ for flight of flights }}
        <article class="group-flight-row{{ if flight.isSelected }} is-selected{{ /if }}" data-group-flight-row data-group-flight-id="{{ flight.id }}">
          <a class="group-flight-thumbnail" href="{{ flight.detailHref }}" aria-label="View {{ flight.pilotName }} flight"><picture><source media="(max-width: 767px)" srcset="{{ if typeof flight.thumbnail !== 'undefined' && flight.thumbnail }}{{ flight.thumbnail.squareUrl }}{{ else }}/flight-thumbnail-fallback.webp{{ /if }}" type="image/webp"><img data-flight-thumbnail src="{{ if typeof flight.thumbnail !== 'undefined' && flight.thumbnail }}{{ flight.thumbnail.wideUrl }}{{ else }}/flight-thumbnail-fallback.webp{{ /if }}" alt="" loading="lazy" width="160" height="90"></picture></a>
          <div class="group-flight-pilot"><span class="group-pilot-avatar" style="--pilot-color: {{ flight.pilotColor }}">{{ flight.pilotInitials }}</span><div><strong>{{ flight.pilotName }}</strong><small>{{ flight.launchTime }}</small></div></div>
          <span><b>{{ flight.fivePointDistance }}</b><small>5-point</small></span><span><b>{{ flight.duration }}</b><small>Duration</small></span>
          <div class="group-flight-actions">{{ if flight.trackHref }}<button type="button" data-group-flight-track data-group-flight-id="{{ flight.id }}" class="group-track-link" aria-pressed="{{ if flight.isSelected }}true{{ else }}false{{ /if }}" disabled>{{ if flight.isSelected }}Track shown on map{{ else }}Show track{{ /if }}</button>{{ /if }}<a href="{{ flight.detailHref }}" aria-label="View {{ flight.pilotName }} flight">View</a></div>
        </article>
      {{ /for }}</div>{{ if typeof flightsLoadMoreHref !== 'undefined' }}<a class="group-button group-button--quiet" href="{{ flightsLoadMoreHref }}" data-group-flights-load-more>Load more flights</a>{{ /if }}{{ else }}<p class="profile-empty">No qualifying flights this month yet.</p>{{ /if }}
    </section>
    {{ if group.isOwner }}<section class="group-card group-management-card" id="group-member-management"><header class="section-heading"><div>{{ include "authenticated/components/icon.vto" { name: "users" } }}<h2>Manage members</h2></div></header>{{ if group.inviteSearchHref && group.inviteSubmitHref }}<form method="post" action="{{ group.inviteSubmitHref }}" class="group-invite-form" data-group-invite-form data-search-href="{{ group.inviteSearchHref }}"><label for="group-invite-pilot">Invite a registered pilot</label><div><input id="group-invite-pilot" type="search" autocomplete="off" required placeholder="Search registered pilots" role="combobox" aria-autocomplete="list" aria-controls="group-invite-results" aria-expanded="false" data-group-invite-search><input type="hidden" name="userId" data-group-invite-user-id><button type="submit" class="group-button">Send invite</button></div><div id="group-invite-results" class="group-invite-results" data-group-invite-results role="listbox" hidden></div><p class="group-invite-status" data-group-invite-status aria-live="polite"></p></form>{{ /if }}{{ if group.members }}<ul class="group-roster">{{ for member of group.members }}<li><span><strong>{{ member.displayName }}</strong><small>{{ member.status }}</small></span>{{ if member.removeHref }}<form method="post" action="{{ member.removeHref }}"><button type="submit" class="group-button group-button--quiet">Remove</button></form>{{ else if member.cancelHref }}<form method="post" action="{{ member.cancelHref }}"><button type="submit" class="group-button group-button--quiet">Cancel</button></form>{{ /if }}</li>{{ /for }}</ul>{{ /if }}{{ if group.deleteHref }}<form method="post" action="{{ group.deleteHref }}" onsubmit="return confirm('Delete this group?')"><button type="submit" class="group-danger-button">Delete group</button></form>{{ /if }}</section>{{ /if }}
  </section>
{{ /layout }}
