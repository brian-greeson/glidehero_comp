{{ layout "layouts/appLayout.vto" }}

  <section class="admin-page">
    {{ include "admin/components/adminNav.vto" { activeAdminPage: "system" } }}
    <div class="admin-content">
      {{ include "admin/components/adminSystemNav.vto" { activeSystemPage: "map-settings" } }}
      <div>
        <p class="admin-eyebrow">System</p>
        <h1>Map settings</h1>
        <p class="muted">Adjust the tile zoom ranges for this server runtime. Settings reset when the process restarts.</p>
      </div>
      {{ if saveSuccess }}<p class="success" role="status">Map settings were updated for this runtime.</p>{{ /if }}
      {{ if saveError }}<p class="error" role="alert">Enter whole-number zooms from 0 to 22, with each minimum no greater than its maximum.</p>{{ /if }}
      <form class="admin-map-settings" method="post" action="/admin/map-settings">
        <fieldset>
          <legend>Personal tiles</legend>
          <div class="admin-map-setting-fields">
            <label>Minimum zoom<input type="number" name="personalMinimumZoom" min="0" max="22" step="1" required value="{{ if settings.personal.minimumZoom === 0 }}0{{ else }}{{ settings.personal.minimumZoom }}{{ /if }}"></label>
            <label>Maximum zoom<input type="number" name="personalMaximumZoom" min="0" max="22" step="1" required value="{{ if settings.personal.maximumZoom === 0 }}0{{ else }}{{ settings.personal.maximumZoom }}{{ /if }}"></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Competition tiles</legend>
          <p class="muted">Shared by Global and Arena maps.</p>
          <div class="admin-map-setting-fields">
            <label>Minimum zoom<input type="number" name="competitionMinimumZoom" min="0" max="22" step="1" required value="{{ if settings.competition.minimumZoom === 0 }}0{{ else }}{{ settings.competition.minimumZoom }}{{ /if }}"></label>
            <label>Maximum zoom<input type="number" name="competitionMaximumZoom" min="0" max="22" step="1" required value="{{ if settings.competition.maximumZoom === 0 }}0{{ else }}{{ settings.competition.maximumZoom }}{{ /if }}"></label>
          </div>
        </fieldset>
        <button type="submit">Save settings</button>
      </form>
    </div>
  </section>
{{ /layout }}
