{{ layout "layouts/appLayout.vto" }}

  <section class="admin-page">
    {{ include "admin/components/adminNav.vto" { activeAdminPage: "system" } }}
    <div class="admin-content">
      {{ include "admin/components/adminSystemNav.vto" { activeSystemPage: "recent" } }}
      <div>
        <p class="admin-eyebrow">Administration</p>
        <h1>Recent activity</h1>
        <p class="muted">The 100 most recently uploaded flights.</p>
      </div>
      {{ if reprocessSuccess }}<p class="success" role="status">Flight cells were reprocessed.</p>{{ /if }}
      {{ if reprocessError }}<p class="error" role="alert">We could not reprocess that flight. Its existing cells were left unchanged.</p>{{ /if }}
      {{ if workerControlSuccess }}<p class="success" role="status">Worker control state was updated.</p>{{ /if }}
      {{ if workerControlError }}<p class="error" role="alert">We could not update the worker control state.</p>{{ /if }}
      {{ if queueSummary }}
        <dl class="admin-queue-summary">
          <div><dt>Queued</dt><dd>{{ if queueSummary.queued === 0 }}0{{ else }}{{ queueSummary.queued }}{{ /if }}</dd></div>
          <div><dt>Processing</dt><dd>{{ if queueSummary.processing === 0 }}0{{ else }}{{ queueSummary.processing }}{{ /if }}</dd></div>
          <div><dt>Failed</dt><dd>{{ if queueSummary.failed === 0 }}0{{ else }}{{ queueSummary.failed }}{{ /if }}</dd></div>
          <div><dt>Oldest queued</dt><dd>{{ if queueSummary.oldestQueuedAgeSeconds === null }}—{{ else if queueSummary.oldestQueuedAgeSeconds === 0 }}0s{{ else }}{{ queueSummary.oldestQueuedAgeSeconds }}s{{ /if }}</dd></div>
        </dl>
      {{ /if }}
      {{ if workerControlState }}
        <section class="admin-worker-control">
          <h2>Flight workers</h2>
          <p>Global control state: <strong>{{ workerControlState }}</strong></p>
          <form method="post" action="/admin/worker-control">
            <input type="hidden" name="state" value="{{ if workerControlState === 'paused' }}running{{ else }}paused{{ /if }}">
            <button type="submit">{{ if workerControlState === 'paused' }}Resume workers{{ else }}Pause workers{{ /if }}</button>
          </form>
        </section>
        <div class="admin-table-wrap">
          <table class="admin-flight-table">
            <caption class="sr-only">Live flight worker status</caption>
            <thead><tr><th scope="col">Worker ID</th><th scope="col">State</th><th scope="col">Current job</th><th scope="col">Processed</th><th scope="col">Failed</th><th scope="col">Last error</th><th scope="col">Heartbeat</th><th scope="col">Online</th></tr></thead>
            <tbody>
              {{ for worker of workers }}
                <tr>
                  <td>{{ worker.workerId }}</td>
                  <td>{{ worker.state }}</td>
                  <td>{{ worker.currentJobId ?? '—' }}</td>
                  <td>{{ if worker.processedCount === 0 }}0{{ else }}{{ worker.processedCount }}{{ /if }}</td>
                  <td>{{ if worker.failedCount === 0 }}0{{ else }}{{ worker.failedCount }}{{ /if }}</td>
                  <td>{{ worker.lastError ?? '—' }}</td>
                  <td>{{ worker.heartbeat }}</td>
                  <td>{{ if worker.online }}Online{{ else }}Offline{{ /if }}</td>
                </tr>
              {{ /for }}
              {{ if workers.length === 0 }}<tr><td colspan="8" class="muted">No live workers reported.</td></tr>{{ /if }}
            </tbody>
          </table>
        </div>
      {{ /if }}
      <div class="admin-table-wrap">
        <table class="admin-flight-table">
          <thead><tr><th scope="col">Flight date</th><th scope="col">Pilot</th><th scope="col">File</th><th scope="col">Status</th><th scope="col"><span class="sr-only">Action</span></th></tr></thead>
          <tbody>
            {{ for flight of flights }}
              <tr>
                <td>{{ flight.flightDate ?? '—' }}</td>
                <td>{{ flight.pilotEmail }}</td>
                <td>{{ flight.originalFilename }}</td>
                <td>{{ flight.processingStatus }}</td>
                <td>{{ if flight.processingStatus === 'completed' }}<form method="post" action="/admin/flights/{{ flight.id }}/reprocess"><button type="submit" class="admin-reprocess-button">Reprocess</button></form>{{ /if }}</td>
              </tr>
            {{ /for }}
          </tbody>
        </table>
      </div>
    </div>
  </section>
{{ /layout }}
